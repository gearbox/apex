# =============================================================================
# Apex API - Staging Environment Variables
# =============================================================================
# Copy this file to .env.staging and fill in real values.
# NEVER commit .env.staging to version control.
#
# Usage:
#   docker compose --env-file .env.staging \
#     -f docker-compose.yml -f docker-compose.staging.yml up -d
# =============================================================================

# --- Docker Image ---
# The image built and pushed by GitHub Actions CI
# Format: ghcr.io/<github-org>/<repo-name>:staging
API_IMAGE=ghcr.io/yourorg/apex-api:staging

# --- PostgreSQL ---
POSTGRES_USER=apex_staging
POSTGRES_PASSWORD=change-me-use-a-strong-password
POSTGRES_DB=apex_staging

# --- JWT ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=generate-a-strong-secret-key-here
JWT_ISSUER=apex-api-staging
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cloudflare R2 Storage (SCOPED PER BUCKET - STAGING BUCKET) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=apex-staging

# --- Cloudflare Tunnel ---
# Get this from: Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Configure
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# --- AI Providers ---
XAI_API_KEY=your-xai-api-key
COMFYUI_HOST=host.docker.internal
COMFYUI_PORT=18188


# Vast.ai API
VASTAI_API_KEY=

# --- Logging ---
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# --- DB Pool (smaller than prod) ---
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=5


# --- Branding ---
APP_NAME=Apex
SUPPORT_EMAIL=support@apex.ai
