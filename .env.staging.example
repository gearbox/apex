# =============================================================================
# Apex API - Staging Environment Variables
# =============================================================================
# Copy this file to .env.staging and fill in real values.
# NEVER commit .env.staging to version control.
#
# Usage:
#   docker compose --env-file .env.staging \
#     -f docker-compose.yml -f docker-compose.staging.yml up -d
# =============================================================================

# --- Docker Image ---
# The image built and pushed by GitHub Actions CI
# Format: ghcr.io/<github-org>/<repo-name>:staging
API_IMAGE=ghcr.io/yourorg/apex-api:staging

# --- PostgreSQL ---
POSTGRES_USER=apex_staging
POSTGRES_PASSWORD=change-me-use-a-strong-password
POSTGRES_DB=apex_staging

# --- JWT ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=generate-a-strong-secret-key-here
JWT_ISSUER=apex-api-staging
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cloudflare R2 Storage (SCOPED PER BUCKET - STAGING BUCKET) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=apex-staging

# --- Cloudflare Tunnel (apex API's OWN cloudflared sidecar) ---
# This token is for the staging apex-API's outbound cloudflared connection
# (the `cloudflared` service in docker-compose.staging.yml) which exposes the
# API as `staging.your-domain.com`. It is DIFFERENT from AISHA_CF_API_TOKEN
# below, which is a Cloudflare API token apex uses at runtime to create
# per-session tunnels for GPU nodes.
# Get this from: Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Configure
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# --- AI Providers ---
XAI_API_KEY=your-xai-api-key
COMFYUI_HOST=host.docker.internal
COMFYUI_PORT=18188

# --- Vast.ai (GPU node provisioning) ---
VASTAI_API_KEY=your-vastai-api-key

# --- Cloudflare API (per-session GPU node tunnels — distinct from CLOUDFLARE_TUNNEL_TOKEN above) ---
# These credentials let apex create per-session tunnels for GPU nodes via the Cloudflare API.
# Requires a Cloudflare API token with Tunnel:Edit + DNS:Edit permissions on the zone below.
AISHA_CF_API_TOKEN=your-cloudflare-api-token
AISHA_CF_ACCOUNT_ID=your-cloudflare-account-id
AISHA_CF_ZONE_ID=your-cloudflare-zone-id
AISHA_CF_TUNNEL_DOMAIN=your-domain.com

# --- Aisha CLI runtime (forwarded to GPU nodes via vastai_client.create_instance) ---
# AI_BUNDLES_GITHUB_TOKEN: PAT with read:packages access to the private gearbox/ai-bundles repo
AI_BUNDLES_GITHUB_TOKEN=ghp_your-personal-access-token
AI_BUNDLES_REPO_URL=https://github.com/gearbox/ai-bundles.git
AI_BUNDLES_BRANCH=master
AISHA_REPO_URL=https://github.com/gearbox/aisha.git
AISHA_BRANCH=master
AISHA_COMFYUI_HOST=0.0.0.0
AISHA_COMFYUI_EXTRA_ARGS=

# --- Model-download tokens (forwarded to GPU nodes; most bundles need HF_TOKEN) ---
# Public HF and Civitai models work without a token; private/gated models do not.
HF_TOKEN=
CIVITAI_API_TOKEN=

# --- Apex callback URL (phase-2; must be the public staging URL once cloudflared is up) ---
# Used as ACS_APEX_CALLBACK_URL forwarded to the Aisha CLI on GPU nodes.
# Replace with the real public URL after the cloudflared sidecar is configured.
APEX_CALLBACK_URL=https://staging.your-domain.com

# GPU session provisioning
# Max provisioning wall-clock (covers large model downloads)
GPU_PROVISION_TIMEOUT_SECONDS=2000

# --- Aisha poller (background worker for ComfyUI job state) ---
AISHA_POLLER_ENABLED=true
AISHA_POLLER_TICK_INTERVAL_SECONDS=1.0
AISHA_POLLER_MAX_CONCURRENT_POLLS=16
AISHA_POLLER_JOB_AGE_WARNING_SECONDS=300
AISHA_POLLER_JOB_AGE_TIMEOUT_SECONDS=1800
AISHA_POLLER_COMFYUI_REQUEST_TIMEOUT_SECONDS=5.0

# --- Logging ---
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# --- DB Pool (smaller than prod) ---
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=5

# --- Branding ---
APP_NAME=Apex
SUPPORT_EMAIL=support@apex.ai
