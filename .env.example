# Apex API Configuration
# Copy to .env and update values

# =============================================================================
# JWT Authentication
# Generate a secure secret key using Python:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================
JWT_SECRET_KEY=your-secure-random-key-here-use-secrets-module
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=apex-api

# =============================================================================
# ComfyUI Connection
# =============================================================================
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=18188

# =============================================================================
# API Server
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
# Enable OpenAPI docs (Swagger UI) at /docs and ReDoc at /redoc;
# set to false in production for security; set to true in dev for convenience.
ENABLE_DOCS=true
# Number of Granian ASGI worker processes. Values > 1 require REDIS_URL (for
# worker leader election) unless WORKER_MODE=api_only — see below.
ASGI_WORKERS=1

# =============================================================================
# Background Workers
# =============================================================================
# Which in-process background workers this process runs. "all" (default)
# starts every worker (token cleanup, Aisha/Grok polling, GPU provisioning,
# health snapshots, ...) alongside the API. "api_only" starts none — use for
# an API-only Granian process when workers run elsewhere (or when running
# ASGI_WORKERS > 1 without Redis, which the startup guard otherwise rejects).
WORKER_MODE=all
# Maximum concurrent xAI status polls per Grok video worker tick.
GROK_VIDEO_MAX_CONCURRENT_POLLS=8

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# Required — no default. Generate with: openssl rand -base64 24
# Must match the password docker-compose.yml uses for the postgres container;
# a diverged pair (container has one password, DATABASE_URL another) fails
# to connect.
POSTGRES_PASSWORD=

# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://apex:apex@localhost:5432/apex
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# =============================================================================
# Redis (pub/sub, rate limiting)
# =============================================================================
# Required — no default. Generate with: openssl rand -base64 24
# The docker-compose redis container refuses to start without this, and its
# host port is loopback-only, so an accidentally-exposed instance is still
# password-protected.
REDIS_PASSWORD=
#
# REDIS_URL is only needed for NON-Docker local runs (running the API on the
# host against a local redis). Under docker-compose it is composed from
# REDIS_PASSWORD automatically — leave it unset there. If you set it, the
# password MUST match REDIS_PASSWORD:
# REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0

# =============================================================================
# Web Push (optional — all three + REDIS_URL required to enable)
# =============================================================================
# Generate with: uv run python tools/generate_vapid_keys.py
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@apex.ai
# PUSH_BROADCAST_CONCURRENCY=10

# =============================================================================
# Telegram Ops Notifications (optional — bot token + REDIS_URL required to enable)
# =============================================================================
# Create a bot via @BotFather and paste the token here.
#
# Telegram allows exactly ONE active getUpdates long-poll per bot token,
# platform-wide. Each environment MUST use its own bot — sharing a token makes
# each environment terminate the other's poll (HTTP 409) indefinitely.
# Leave empty to disable Telegram entirely (see Settings.telegram_enabled).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_LINK_TOKEN_TTL_SECONDS=900
# TELEGRAM_SEND_TIMEOUT_SECONDS=10.0
# TELEGRAM_POLL_TIMEOUT_SECONDS=25

# =============================================================================
# Cloudflare R2 Storage
# =============================================================================
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=apex-user-content

# Optional: Custom domain for public URLs (if configured in R2)
# R2_PUBLIC_URL_BASE=https://cdn.yourdomain.com

# Public assets bucket — a SEPARATE, publicly-readable bucket for static
# assets (currently: cached payment currency logos). Must NOT be the same
# bucket as R2_BUCKET_NAME above, which is private and served only through
# the cookie-authenticated content proxy — making it public would gut that
# auth model. Setup:
#   1. Create a new R2 bucket (e.g. apex-public-assets).
#   2. Attach a public custom domain to it in the Cloudflare dashboard.
#   3. Set both vars below to that bucket name and domain.
# When either is unset, logo caching is disabled (a one-time startup warning
# is logged) but currency availability/metadata sync still runs normally —
# GET /v1/billing/currencies then serves logo_url: null for every entry.
# R2_PUBLIC_ASSETS_BUCKET=apex-public-assets
# R2_PUBLIC_ASSETS_URL_BASE=https://assets.yourdomain.com

# =============================================================================
# Content Retention
# =============================================================================
# Number of days to retain user content before automatic cleanup
RETENTION_DAYS=7

# Enable the periodic content retention sweeper that enforces RETENTION_DAYS
CONTENT_CLEANUP_ENABLED=true

# Seconds between content retention sweep runs (60-86400)
CONTENT_CLEANUP_INTERVAL_SECONDS=900

# Max expired rows fetched per sweep batch, per content type (1-5000)
CONTENT_CLEANUP_BATCH_SIZE=500

# Upper bound on batches drained in a single sweep run, i.e. backlog control (1-200)
CONTENT_CLEANUP_MAX_BATCHES_PER_RUN=20

# =============================================================================
# NowPayments
# =============================================================================
# Absolute public URL of this environment's NowPayments IPN endpoint, required 
# for NowPayments charges; passed per-invoice so environments sharing one
# NowPayments account each receive their own IPNs.
NOWPAYMENTS_IPN_CALLBACK_URL=https://api.example.com/v1/billing/webhooks/nowpayments

# =============================================================================
# Payment Currency Catalog Sync
# =============================================================================
# Seconds between periodic payment currency catalog syncs (merchant/coins +
# full-currencies + logo caching). Default 3h; also triggerable on-demand via
# POST /v1/admin/payments/currencies/refresh (300-86400)
PAYMENT_CURRENCY_SYNC_INTERVAL_SECONDS=10800

# =============================================================================
# Video Frame Extraction
# =============================================================================
# Upload-time ffprobe rejection cap for uploaded video duration, in seconds (1-3600)
FRAME_EXTRACT_MAX_VIDEO_SECONDS=300

# Wall-clock timeout for each ffmpeg/ffprobe subprocess invocation, in seconds (1-300)
FRAME_EXTRACT_FFMPEG_TIMEOUT_SECONDS=30

# Seconds between FrameExtractionWorker queue polls (0.5-60)
FRAME_EXTRACT_POLL_INTERVAL_SECONDS=2

# Longest-edge pixel cap for preview strip WEBP frames (64-2048)
FRAME_PREVIEW_MAX_EDGE=512

# Presigned URL TTL for preview frames, generated per-read, in seconds (60-86400)
FRAME_PREVIEW_URL_TTL_SECONDS=3600

# Documented R2 lifecycle-rule value (days) for the 'frame-previews/' prefix.
# Informational only — you must also configure the matching R2 lifecycle rule
# out-of-band; this setting does not enforce deletion itself (1-30)
FRAME_PREVIEW_RETENTION_DAYS=2

# A frame_extraction_jobs row stuck in 'running' longer than this (seconds) is
# assumed orphaned by a dead worker and failed by the next sweep (300-7200).
# Must be >= max(MAX_PREVIEW_FRAME_COUNT, MAX_EXTRACT_TIMESTAMPS) * FRAME_EXTRACT_FFMPEG_TIMEOUT_SECONDS
FRAME_EXTRACT_STALE_RUNNING_SECONDS=1800

# Maximum upload file size in MB (1-100)
MAX_UPLOAD_SIZE_MB=20

# Decompression-bomb gate: max decoded pixel count (megapixels) for input
# images (upload + i2i remix), enforced before full decode
IMAGE_MAX_INPUT_MEGAPIXELS=100.0

# Grok auth
XAI_API_KEY=your_grok_api_key_here

# Vast.ai API
# Required for GPU node management
VASTAI_API_KEY=

# =============================================================================
# GPU Session Provisioning (ai-bundles + Aisha CLI)
# =============================================================================
# GitHub PAT with read access to gearbox/ai-bundles (REQUIRED for private clone)
AI_BUNDLES_GITHUB_TOKEN=

# ai-bundles repository URL and branch (apex is source of truth)
AI_BUNDLES_REPO_URL=https://github.com/gearbox/ai-bundles.git
AI_BUNDLES_BRANCH=master

# HuggingFace and Civitai tokens for model downloads on GPU nodes
HF_TOKEN=
CIVITAI_API_TOKEN=

# Aisha CLI runtime (forwarded to GPU nodes via vastai_client.create_instance)
AISHA_REPO_URL=https://github.com/gearbox/aisha.git
AISHA_BRANCH=master
# ComfyUI bind address — must remain 0.0.0.0 in production so cloudflared can reach it
AISHA_COMFYUI_HOST=0.0.0.0
# Extra args appended to ComfyUI launch (e.g. '--preview-method auto')
AISHA_COMFYUI_EXTRA_ARGS=

# Phase-2 callback URL for GPU node → Apex callbacks (leave empty for Phase 1)
APEX_CALLBACK_URL=

# GPU session provisioning
# Max provisioning wall-clock (covers large model downloads)
GPU_PROVISION_TIMEOUT_SECONDS=2000
# Stall timeout: seconds of callback silence before treating a provisioning session as stalled.
# Only activates when callbacks are flowing; falls back to GPU_PROVISION_TIMEOUT_SECONDS otherwise.
GPU_PROVISION_STALL_TIMEOUT_SECONDS=420
# Grace period before the reconciler marks an unreachable session stale (seconds).
# Default 120s = 2× the 60s reconcile cycle; absorbs a single transient probe failure.
GPU_SESSION_STALE_GRACE_SECONDS=120

# =============================================================================
# Aisha Job Poller (background ComfyUI polling worker)
# =============================================================================
AISHA_POLLER_ENABLED=true
AISHA_POLLER_TICK_INTERVAL_SECONDS=1.0
AISHA_POLLER_MAX_CONCURRENT_POLLS=16
AISHA_POLLER_JOB_AGE_WARNING_SECONDS=300
AISHA_POLLER_JOB_AGE_TIMEOUT_SECONDS=1800
AISHA_POLLER_COMFYUI_REQUEST_TIMEOUT_SECONDS=5.0

# --- Cloudflare API (per-session GPU node tunnels — distinct from CLOUDFLARE_TUNNEL_TOKEN) ---
# These credentials let apex create per-session tunnels for GPU nodes via the Cloudflare API.
# AISHA_CF_TUNNEL_DOMAIN is required when AISHA_POLLER_ENABLED=true (SSRF protection).
# If AISHA_CF_TUNNEL_DOMAIN is empty and AISHA_POLLER_ENABLED=true, the app will refuse to start.
# Set AISHA_POLLER_ENABLED=false in dev environments without a GPU tunnel.
# Example domain: your-domain.com
AISHA_CF_API_TOKEN=
AISHA_CF_ACCOUNT_ID=
AISHA_CF_ZONE_ID=
AISHA_CF_TUNNEL_DOMAIN=your-domain.com

# =============================================================================
# Generation Defaults
# =============================================================================
DEFAULT_STEPS=12
MAX_STEPS=20
DEFAULT_CFG=1.1
DEFAULT_SAMPLER=euler
DEFAULT_SCHEDULER=beta

# Email (Resend — https://resend.com)
# Leave empty to use LogEmailService (stdout only — fine for local dev)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Apex

# Frontend URL (used in verification/reset email links)
APP_URL=http://localhost:3000

# Branding
APP_NAME=Apex
SUPPORT_EMAIL=support@apex.ai

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_FORGOT_PASSWORD=3/hour
RATE_LIMIT_RESEND_VERIFICATION=3/hour

# Client IP trust for rate limiting. "none" (default) uses only the raw ASGI
# connection address — safe for local dev, but in production every client
# behind the same proxy/load balancer then shares one rate-limit bucket.
# Set to "cf-connecting-ip" behind Cloudflare, or "x-forwarded-for" behind a
# generic reverse proxy (pair with TRUSTED_PROXY_HOPS). Never trust the
# leftmost X-Forwarded-For entry — it is fully client-controlled.
TRUSTED_IP_HEADER=none
TRUSTED_PROXY_HOPS=0
